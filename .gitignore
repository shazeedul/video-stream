# Root .gitignore for monorepo

# Local environment & secrets
.env
.env.*
!.env.example
.env.backup
.env.local
*.key
*.pem

# Superpowers SDD workspace
.superpowers/

# Node / JS
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log*

# Composer / PHP
vendor/
.phpunit.cache
.phpunit.result.cache

# Go / Worker
worker/worker
*.test
*.out

# OS
.DS_Store
._*
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes

# Backups
infrastructure/backups/
*.sql.gz

# IDEs
.idea/
.vscode/
*.swp
*.swo
.build/
